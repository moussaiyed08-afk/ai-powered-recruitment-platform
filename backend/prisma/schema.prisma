// ============================================================
// FICHIER : prisma/schema.prisma
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// MODÈLES
// ============================================================

model Job {
  id          Int      @id @default(autoincrement())
  title       String
  company     String
  description String   @db.Text
  createdAt   DateTime @default(now())

  // RELATION : Le job appartient à un recruteur (User)
  recruiterId Int
  recruiter   User     @relation(fields: [recruiterId], references: [id])

  // RELATION : Un Job peut être lié à plusieurs Candidatures
  candidatures Candidature[]
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String
  role       String   // "CANDIDAT" ou "RECRUTEUR"
  
  nom        String
  prenom     String
  
  entreprise String?  // Uniquement pour le RECRUTEUR
  enChomage  Boolean? // Uniquement pour le CANDIDAT
  
  createdAt  DateTime @default(now())

  // RELATION : Un utilisateur (recruteur) peut avoir créé plusieurs jobs
  jobs       Job[]
}

model Candidature {
  id        Int      @id @default(autoincrement())
  fileName  String
  cvContent String   @db.Text
  score     Int?     
  createdAt DateTime @default(now())
  
  // Relation avec le job
  jobId     Int
  job       Job      @relation(fields: [jobId], references: [id])
}